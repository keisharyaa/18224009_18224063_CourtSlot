# Windows local: set an absolute path when running outside Docker.
COURTSLOT_DB_PATH=data/courtslot.sqlite3
COURTSLOT_BIND_PORT=8000
# Set distinct private values in your shell or an untracked .env before partner requests.
COURTSLOT_AERIVA_API_KEY=
COURTSLOT_LOCALLOOP_API_KEY=
# Generate a private random value of at least 32 characters; required for login.
COURTSLOT_TOKEN_SECRET=
